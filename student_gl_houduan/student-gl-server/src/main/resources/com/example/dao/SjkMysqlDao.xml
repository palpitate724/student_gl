<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.dao.SjkMysqlDao">


    <!-- 登录查询-->
    <select id="login" resultType="com.example.model.UserStu">
        select * from student_gl_name_password
        <where>
            <if test="userstu.sid!=null and userstu.spassword!=null">
                    sid=#{userstu.sid} and spassword=#{userstu.spassword}
            </if>
            <if test="userstu.spassword==null">
                sid=#{userstu.sid}
            </if>
            AND sdelete=0
        </where>
    </select>


    <!--注册_数据写入-->
    <insert id="signup">
        insert into student_gl_name_password (sid,sname,spassword,sjiaose,sdelete)
        values(#{userstu.sid},#{userstu.sname},#{userstu.spassword},#{userstu.sjiaose},0)
    </insert>
    <!--注册_验证-->
    <select id="signupyz">
        select * from student_gl_name_password
        where sid=#{userstu.sid}
    </select>


    <!--学生信息查询/逻辑删除查询-->
    <select id="stuSel" resultType="com.example.model.UserStuSel">
        select * from student_gl_sid
        <where>
            <if test="userstusel.sid!=null and userstusel.sid!=''">
                sid=#{userstusel.sid}
            </if>
            <if test="userstusel.sname!=null and userstusel.sname!=''">
                AND sname= #{userstusel.sname}
            </if>
            <if test="userstusel.sage!=null and userstusel.sage!=''">
                AND sage= #{userstusel.sage}
            </if>
            <if test="userstusel.ssex!=null and userstusel.ssex!=''">
                AND ssex= #{userstusel.ssex}
            </if>
            <if test="userstusel.ssion!=null and userstusel.ssion!=''">
                AND ssion= #{userstusel.ssion}
            </if>
            AND sdelete=#{userstusel.sdelete}
        </where>
        limit #{userstusel.ts},#{userstusel.shul}
    </select>

    <!--学生信息添加-->
    <insert id="stuIns">
        insert into student_gl_sid (sid,sname,sage,ssex,ssion,sdelete)
        values(#{userstuinto.sid},#{userstuinto.sname},#{userstuinto.sage},#{userstuinto.ssex},#{userstuinto.ssion},0)
    </insert>
    <!--学生信息添加__验证是否软删除-->
    <select id="stuInsDel" resultType="int">
        select count(*) from student_gl_sid
        where sid=#{userstuinto.sid} and sdelete=1
    </select>
    <!--学生信息添加__验证是否已存在-->
    <select id="stuInsYz" resultType="int">
        select count(*) from student_gl_sid
        where sid= #{userstuinto.sid} and sdelete=0
    </select>


    <!--学生信息修改-->
    <update id="stuUp">
        update student_gl_sid
        <set>
            <if test="userstuinto.sname!=null">
                sname=#{userstuinto.sname},
            </if>
            <if test="userstuinto.sage!=null">
                sage=#{userstuinto.sage},
            </if>
            <if test="userstuinto.ssex!=null">
                ssex=#{userstuinto.ssex},
            </if>
            <if test="userstuinto.ssion!=null">
                ssion=#{userstuinto.ssion},
            </if>
        </set>
        <where>
            sid=#{userstuinto.sid}
        </where>
    </update>


    <!--学生信息删除--><!-- 逻辑删除/软删除-->
    <update id="stuDelr">
        update student_gl_sid
        set sdelete=1
        where sid=#{userstuinto.sid}
    </update>
    <!--学生信息恢复-->
    <update id="stuDelHuiFu">
        update student_gl_sid
        set sdelete=0
        where sid= #{userstuinto.sid}
    </update>


    <!-- 计算学生信息数量-->
    <select id="stuCount" resultType="int">
        select count(*) from student_gl_sid
        <where>
            <if test="userstusel.sid!=null and userstusel.sid!=''">
                sid=#{userstusel.sid}
            </if>
            <if test="userstusel.sname!=null and userstusel.sname!=''">
                AND sname= #{userstusel.sname}
            </if>
            <if test="userstusel.sage!=null and userstusel.sage!=''">
                AND sage= #{userstusel.sage}
            </if>
            <if test="userstusel.ssex!=null and userstusel.ssex!=''">
                AND ssex= #{userstusel.ssex}
            </if>
            <if test="userstusel.ssion!=null and userstusel.ssion!=''">
                AND ssion= #{userstusel.ssion}
            </if>
            AND sdelete= #{userstusel.sdelete}
        </where>
    </select>

</mapper>